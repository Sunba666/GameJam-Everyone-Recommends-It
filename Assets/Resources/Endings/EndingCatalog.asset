  endings:
  - id: 0
    title: "\u732B\u54AA\u5F53\u5BB6"
    description: "\u732B\u8BDD\u9898\u6210\u4E3A\u699C\u9996\u3002\u8C01\u8FD8\u60F3\u7EE7\u7EED\u770B\uFF0C\u8C01\u5DF2\u7ECF\u628A\u6CE8\u610F\u529B\u8F6C\u56DE\u81EA\u5DF1\u7684\u751F\u6D3B\uFF1F\u8FD9\u680B\u697C\u7684\u8BB0\u5F55\u4F1A\u56DE\u7B54\u3002"
    color: {r: 0.72, g: 0.28, b: 0.2, a: 1}
  - id: 1
    title: "\u7F8E\u98DF\u5F53\u9053"
    description: "\u7F8E\u98DF\u6210\u4E86\u6700\u591A\u4F4F\u6237\u613F\u610F\u7EE7\u7EED\u63A5\u89E6\u7684\u8BDD\u9898\u3002\u70ED\u95F9\u6765\u81EA\u4F60\u7684\u63A8\u8350\uFF0C\u8FD8\u662F\u90BB\u5C45\u7684\u5206\u4EAB\uFF1F\u6CBF\u7740\u8BB0\u5F55\u627E\u627E\u770B\u3002"
    color: {r: 0.55, g: 0.34, b: 0.06, a: 1}
  - id: 2
    title: "\u518D\u6765\u4E00\u5C40"
    description: "\u6E38\u620F\u8BDD\u9898\u72EC\u5360\u7B2C\u4E00\u3002\u518D\u770B\u770B\u5404\u4E2A\u623F\u95F4\uFF1A\u8C01\u8FD8\u613F\u610F\u53C2\u4E0E\uFF0C\u8C01\u5DF2\u7ECF\u8F6C\u5411\u522B\u7684\u4E8B\uFF1F"
    color: {r: 0.22, g: 0.33, b: 0.62, a: 1}
  - id: 3
    title: "\u5168\u697C\u5934\u6761"
    description: "\u65B0\u95FB\u6210\u4E86\u697C\u91CC\u7684\u5934\u53F7\u8BDD\u9898\u3002\u662F\u8C01\u5206\u4EAB\u7ED9\u4E86\u8C01\uFF0C\u53C8\u662F\u8C01\u770B\u8FC7\u540E\u6539\u53D8\u4E86\u6D3B\u52A8\uFF1F\u56DE\u770B\u8FD9\u4E00\u8DEF\u3002"
    color: {r: 0.14, g: 0.43, b: 0.41, a: 1}
  - id: 4
    title: "\u540C\u4E00\u9996\u6B4C"
    description: "\u97F3\u4E50\u8BDD\u9898\u767B\u9876\u4E86\u3002\u8C01\u613F\u610F\u7EE7\u7EED\u542C\uFF0C\u8FD9\u6BB5\u5174\u8DA3\u53C8\u7ECF\u8FC7\u54EA\u4E9B\u90BB\u5C45\uFF1F\u6700\u540E\u7684\u751F\u6D3B\u548C\u5206\u4EAB\u8BB0\u5F55\u5C31\u5728\u4E0B\u9762\u3002"
    color: {r: 0.46, g: 0.26, b: 0.62, a: 1}
  - id: 5
    title: "\u52BF\u5747\u529B\u654C"
    description: "\u6700\u9AD8\u4EBA\u6570\u5E76\u5217\uFF0C\u697C\u91CC\u6CA1\u6709\u552F\u4E00\u699C\u9996\u3002\u5404\u6709\u6240\u597D\uFF0C\u4E5F\u5404\u6709\u6765\u8DEF\uFF1B\u770B\u770B\u8FD9\u6B21\u6700\u540E\u7559\u4E0B\u7684\u751F\u6D3B\u3002"
    color: {r: 0.28, g: 0.4, b: 0.32, a: 1}
